rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // دالات التحقق والمصادقة المساعدة (Helper Functions)
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // فحص صلاحية المدير (Admin Verification)
    // يعتمد حصرياً على Custom Claims الموثقة أو وثيقة قاعدة البيانات المعتمدة مع اشتراط توثيق البريد الإلكتروني
    // تم إلغاء الاعتماد المستقل على نص البريد الإلكتروني لمنع الثغرات
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         request.auth.token.email_verified == true)
      );
    }

    // فحص صلاحية المدرس (Instructor Verification)
    function isInstructor() {
      return isSignedIn() && (
        request.auth.token.instructor == true ||
        request.auth.token.role == 'instructor' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'instructor')
      );
    }

    // فحص إسناد المدرس للدورة المحددة
    function isCourseInstructor(courseId) {
      return isInstructor() && 
        exists(/databases/$(database)/documents/courses/$(courseId)) &&
        request.auth.uid in get(/databases/$(database)/documents/courses/$(courseId)).data.instructorIds;
    }

    // فحص تسجيل الطالب المعتمد في الدورة (Approved Enrollment)
    function isApprovedStudent(courseId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/courses/$(courseId)/enrollments/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/courses/$(courseId)/enrollments/$(request.auth.uid)).data.status == 'approved';
    }

    // ==========================================
    // 1. المستخدمون (Users) - حماية الخصوصية ومنع تصعيد الصلاحيات
    // ==========================================
    match /users/{uid} {
      // حماية الخصوصية: الطالب يقرأ ملفه فقط، والمدير يقرأ لإدارة الحسابات
      // تم حظر قراءة المدرس العشوائية لحسابات الطلاب غير المسجلين لديه
      allow read: if isOwner(uid) || isAdmin();

      // إنشاء الحساب: إجباري دور student وحالة active، ومطابقة uid الوثيقة
      allow create: if isOwner(uid) && 
        request.resource.data.role == 'student' &&
        request.resource.data.accountStatus == 'active' &&
        request.resource.data.uid == uid;

      // التعديل: الطالب لا يستطيع تعديل دوره أو حالة حسابه أو تاريخ إنشائه أو البريد
      allow update: if isAdmin() || (
        isOwner(uid) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountStatus', 'createdAt', 'uid', 'email'])
      );

      // الحذف المباشر محظور لحماية النزاهة وسجلات التدقيق
      allow delete: if false;
    }

    // ==========================================
    // 2. الكورسات (Courses) والمحتوى التعليمي
    // ==========================================
    match /courses/{courseId} {
      // الكورسات المنشورة عامة، والمسودات فقط للمدير ومدرس المساق
      allow read: if resource.data.status == 'published' || isAdmin() || isCourseInstructor(courseId);

      // إنشاء الكورسات وحذفها حصري للمدير فقط
      allow create, delete: if isAdmin();

      // التعديل: المدير يعدل كل شيء، بينما المدرس المعتمد يعدل المحتوى دون المساس بـ instructorIds
      allow update: if isAdmin() || (
        isCourseInstructor(courseId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['instructorIds', 'id'])
      );

      // أ. الوحدات والمديولات (Modules)
      match /modules/{moduleId} {
        allow read: if isApprovedStudent(courseId) || isAdmin() || isCourseInstructor(courseId);
        allow write: if isAdmin() || isCourseInstructor(courseId);
      }

      // ب. العناصر والدروس (Items & Lessons)
      match /items/{itemId} {
        allow read: if isApprovedStudent(courseId) || isAdmin() || isCourseInstructor(courseId);
        allow write: if isAdmin() || isCourseInstructor(courseId);
      }

      match /lessons/{lessonId} {
        allow read: if isApprovedStudent(courseId) || isAdmin() || isCourseInstructor(courseId);
        allow write: if isAdmin() || isCourseInstructor(courseId);
      }

      // ج. طلبات الالتحاق (Enrollments)
      match /enrollments/{studentUid} {
        allow read: if isOwner(studentUid) || isAdmin() || isCourseInstructor(courseId);
        
        // الطالب يطلب الالتحاق بحالة pending فقط دون تزوير حالة المراجعة
        allow create: if isOwner(studentUid) && 
          request.resource.data.status == 'pending' &&
          request.resource.data.studentUid == studentUid &&
          !('reviewedBy' in request.resource.data) &&
          !('reviewedAt' in request.resource.data);
        
        // فقط المدير أو مدرس الدورة يعتمد أو يرفض الطلب
        allow update: if isAdmin() || isCourseInstructor(courseId);
        allow delete: if false;
      }

      // د. تقدم الدروس (Lesson Progress)
      match /lessonProgress/{progressDoc} {
        allow read: if isSignedIn() && (
          request.auth.uid == resource.data.studentUid || isAdmin() || isCourseInstructor(courseId)
        );
        allow create, update: if isAdmin() || (
          isApprovedStudent(courseId) &&
          request.resource.data.studentUid == request.auth.uid &&
          request.resource.data.courseId == courseId
        );
        allow delete: if false;
      }

      // هـ. التكليفات والتسليمات (Assignments & Submissions)
      match /assignments/{assignmentId} {
        allow read: if isApprovedStudent(courseId) || isAdmin() || isCourseInstructor(courseId);
        allow write: if isAdmin() || isCourseInstructor(courseId);

        match /submissions/{studentUid} {
          allow read: if isOwner(studentUid) || isAdmin() || isCourseInstructor(courseId);
          
          // الطالب يسلم الرابط فقط عند اعتماده في الكورس، وممنوع إرسال أي حقول درجات
          allow create: if (
            isOwner(studentUid) &&
            isApprovedStudent(courseId) &&
            request.resource.data.studentUid == studentUid &&
            request.resource.data.status == 'submitted' &&
            !('grade' in request.resource.data) &&
            !('gradedBy' in request.resource.data) &&
            !('gradedAt' in request.resource.data)
          ) || isAdmin() || isCourseInstructor(courseId);

          // الطالب يحدث تسليمه دون المساس بحقول التقييم
          allow update: if (
            isOwner(studentUid) &&
            isApprovedStudent(courseId) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['grade', 'gradedBy', 'gradedAt'])
          ) || isAdmin() || isCourseInstructor(courseId);

          allow delete: if false;
        }
      }

      // و. الاختبارات ومحرك الأمان (Exams Engine)
      match /exams/{examId} {
        // بيانات الاختبار العامة متاحة للطالب المسجل بدون مفتاح الإجابات
        allow read: if isApprovedStudent(courseId) || isAdmin() || isCourseInstructor(courseId);
        allow write: if isAdmin() || isCourseInstructor(courseId);

        // 🔒 مفتاح الإجابات السري (Answer Key Isolation) - محظور على الطالب نهائياً
        match /answerKey/{secretDoc=**} {
          allow read, write: if isAdmin() || isCourseInstructor(courseId);
        }

        // محاولات الطلاب (Attempts) - منع تزوير الدرجات عند التسليم
        match /attempts/{attemptDoc} {
          allow read: if (isSignedIn() && request.auth.uid == resource.data.studentUid) || isAdmin() || isCourseInstructor(courseId);
          
          // الطالب يسلم إجاباته فقط، وممنوع تمرير درجات أو تغيير الحالة إلى معتمد
          allow create: if (
            isApprovedStudent(courseId) &&
            isOwner(request.resource.data.studentUid) &&
            request.resource.data.courseId == courseId &&
            request.resource.data.examId == examId &&
            request.resource.data.status in ['in_progress', 'submitted'] &&
            !('calculatedScore' in request.resource.data) &&
            !('officialGrade' in request.resource.data) &&
            !('score' in request.resource.data)
          ) || isAdmin() || isCourseInstructor(courseId);

          // الطالب يحدث الإجابات أثناء الاختبار فقط، وممنوع حقن أي درجات
          allow update: if (
            isOwner(resource.data.studentUid) &&
            resource.data.status == 'in_progress' &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'officialGrade', 'calculatedScore', 'gradedBy'])
          ) || isAdmin() || isCourseInstructor(courseId);

          allow delete: if false;
        }
      }

      // ز. الدرجات الرسمية المعتمدة (Official Grades) - محظور كتابة الطالب نهائياً
      match /officialGrades/{gradeDoc} {
        allow read: if (isSignedIn() && request.auth.uid == resource.data.studentUid) || isAdmin() || isCourseInstructor(courseId);
        allow write: if isAdmin() || isCourseInstructor(courseId);
        allow delete: if false;
      }

      // ح. درجات الامتحان العملي (Practical Grades) - محظور كتابة الطالب نهائياً
      match /practicalGrades/{practicalDoc} {
        allow read: if (isSignedIn() && request.auth.uid == resource.data.studentUid) || isAdmin() || isCourseInstructor(courseId);
        allow write: if isAdmin() || isCourseInstructor(courseId);
        allow delete: if false;
      }
    }

    // ==========================================
    // 3. الشهادات والتحقق العام (Certificates)
    // ==========================================
    match /certificates/{certId} {
      // قراءة الشهادات الصادرة فقط للعامة للتحقق الأكاديمي، بينما الطلبات المعلقة محصورة بصاحبها والمدير
      allow read: if resource.data.status == 'issued' || isAdmin() || (isSignedIn() && request.auth.uid == resource.data.studentUid);

      // إنشاء طلب شهادة: الطالب يقدم طلباً بحالة requested فقط دون تزوير رابط أو اعتماد
      allow create: if isAdmin() || (
        isSignedIn() &&
        isOwner(request.resource.data.studentUid) &&
        request.resource.data.status == 'requested' &&
        !('signedPdfDriveUrl' in request.resource.data) &&
        !('issuedBy' in request.resource.data) &&
        isApprovedStudent(request.resource.data.courseId)
      );

      // التعديل والإصدار وتوثيق التوقيع حصري للمدير فقط
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ==========================================
    // 4. معرض الأبحاث والصفحات العامة (Showcase)
    // ==========================================
    match /researches/{researchId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /testimonials/{testId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /contactMessages/{msgId} {
      // التحقق من صحة وحجم الرسائل لمنع الإغراق
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message']) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 3000;
      allow read, update, delete: if isAdmin();
    }

    match /platformSettings/{settingDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 5. سجل العمليات والتدقيق (Audit Logs) - منع التزوير والانتحال
    // ==========================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // منع انتحال صفة مدراء آخرين: إجباري مطابقة actorUid ومطابقة الدور الفعلي
      allow create: if isSignedIn() && 
        request.resource.data.actorUid == request.auth.uid &&
        (request.resource.data.actorRole != 'admin' || isAdmin()) &&
        (request.resource.data.actorRole != 'instructor' || isInstructor() || isAdmin());
      allow update, delete: if false; // سجل تاريخي غير قابل للتلاعب أو الحذف
    }

    // إغلاق أي مسارات أخرى غير معرفة
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

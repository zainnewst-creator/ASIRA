# ========================================================
# متغيرات بيئة منصة منتدى أسيرا للبحث العلمي (ASIRA LMS)
# انسخ هذا الملف إلى .env وضع بيانات مشروع Firebase الخاص بك
# ========================================================

# مفاتيح اتصال Firebase الحقيقية من Firebase Console
# المسار في Firebase: Project settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789

# ملاحظة:
# إذا لم يتم وضع هذه المتغيرات، ستعمل المنصة تلقائياً في "وضع التجربة السريعة (Demo Mode)"
# بمجرد إضافة هذه المتغيرات في Vercel أو في ملف .env محلياً، سينتقل الموقع تلقائياً للعمل الحقيقي مع Firebase!
